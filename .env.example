# ---------------------------------------------------------------------------
# Athenaeum — environment variables
# Copy to `.env.local` (never commit that file) and fill in real values.
# Source: README.md "Environment variables you will need".
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. Must point at a replica set — the app uses
# transactions for issue / return / reserve-promote / rating recompute.
MONGODB_URI="mongodb://localhost:27017/lms"

# HMAC secret for the JWT session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Cloudinary credentials. The API secret is server-only; the cloud name is also
# exposed to the browser for client-side delivery URLs.
CLOUDINARY_CLOUD_NAME="dbm0wycl6"
CLOUDINARY_API_KEY="873163447559562"
CLOUDINARY_API_SECRET="D_07IzwHsFWRI7wFqouJU7pj3Ng"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="lms"

# Public origin of the deployment, used for share links and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for `POST /api/maintenance/run` (Vercel Cron sends it as the
# `x-cron-secret` header). Admin sessions can trigger the same job.
CRON_SECRET="replace-with-a-long-random-string"
