# ---------------------------------------------------------------------------
# Athenaeum — environment variables
# Copy to `.env.local` (never commit that file) and fill in real values.
# Source: README.md "Environment variables you will need".
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. Must point at a replica set — the app uses
# transactions for issue / return / reserve-promote / rating recompute.
MONGODB_URI="mongodb://localhost:27017/lms"

# HMAC secret for the JWT session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Cloudinary credentials. The API secret is server-only; the cloud name is also
# exposed to the browser for client-side delivery URLs.
#
# The two cloud-name variables MUST hold the same string. They describe one cloud;
# the first is server-only, the second is inlined into the client bundle at build
# time because the browser needs it for delivery URLs. A mismatch 404s every image,
# so keep them in step — the server value wins if they ever disagree at runtime
# (see `resolveCloudName`).
#
# NEVER commit real credentials in this file — it ships with the repo. Real values
# live in `.env.local` only.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-api-key"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Public origin of the deployment, used for share links and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for `POST /api/maintenance/run` (Vercel Cron sends it as the
# `x-cron-secret` header). Admin sessions can trigger the same job.
CRON_SECRET="replace-with-a-long-random-string"
